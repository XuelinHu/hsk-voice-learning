# Copy to .env for local use. Never commit the real values.
DASHSCOPE_API_KEY=replace-with-your-key
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
TOKEN_SECRET=replace-with-a-long-random-value
PORT=8040
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=hsk_voice_learning_app
DB_PASSWORD=replace-with-this-project-role-password
DB_NAME=hsk_voice_learning_dev
DB_POOL_SIZE=10
DB_SSL=false
DB_BACKUP_ENCRYPTION_KEY=
# Demo users are seeded only by an explicit development-only command. Never enable this in production.
ALLOW_DEMO_SEED=0
DEMO_SEED_DATABASE=hsk_voice_learning_dev
HSK_STUDENT_PASSWORD=
HSK_TEACHER_PASSWORD=
# Optional LAN OpenAI-compatible chat endpoint. Never embed this URL or a provider key in the APK.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
WEB_PORT=4035
OIDC_ISSUER=https://192.168.1.9:8042/realms/front
OIDC_CLIENT_IDS=hsk-dialogue-android,hsk-mission-android
# LAN deployment: set both paths to the private development server certificate and key.
TLS_CERT_PATH=
TLS_KEY_PATH=
WEB_API_HOST=192.168.1.9
